# Base URL of the TopoPuzzle Python backend.
# Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Optional MapLibre style URL (e.g. a MapTiler / self-hosted style.json).
# When unset, the map falls back to a fully-offline cream cartographic style
# with a subtle graticule, so no public tile servers are ever contacted.
# NEXT_PUBLIC_MAP_STYLE=https://api.maptiler.com/maps/basic-v2/style.json?key=YOUR_KEY
#
# Keyless alternatives, no signup:
#   https://tiles.openfreemap.org/styles/liberty
#   https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Optional: shade the map using the same terrarium DEM the mesh is built from,
# so the relief you aim the selection box at is the relief you print. Keyless,
# but it DOES contact the AWS elevation-tiles bucket — hence opt-in, to keep the
# no-env-file default genuinely offline. Set to 1 to enable.
# NEXT_PUBLIC_MAP_HILLSHADE=1
